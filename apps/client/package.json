{
  "name": "@oryzae/client",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "set -a; [ -f ../../.env ] && . ../../.env || echo '[dev] ../../.env not found — using ambient env (CI)'; set +a; next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/",
    "test:watch": "vitest",
    "dep-cruise": "depcruise src --config .dependency-cruiser.cjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verify:record": "node scripts/record-verify.mjs"
  },
  "dependencies": {
    "@oryzae/server": "workspace:*",
    "@oryzae/shared": "workspace:*",
    "@oryzae/verify": "workspace:*",
    "@sentry/nextjs": "^10.72.0",
    "next": "16.3.3",
    "next-intl": "^4.14.1",
    "posthog-js": "^1.422.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "dependency-cruiser": "^18.2.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
