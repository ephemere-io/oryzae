{
  "name": "@oryzae/client",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "set -a && . ../../.env && set +a && next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/",
    "test:watch": "vitest",
    "dep-cruise": "depcruise src --config .dependency-cruiser.cjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verify:record": "node scripts/record-verify.mjs"
  },
  "dependencies": {
    "@oryzae/server": "workspace:*",
    "@oryzae/shared": "workspace:*",
    "@oryzae/verify": "workspace:*",
    "@sentry/nextjs": "^10.68.0",
    "next": "16.2.12",
    "next-intl": "^4.13.4",
    "posthog-js": "^1.407.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dependency-cruiser": "^17.4.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
